generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === ENUMS ===
enum RoleName {
  admin
  user
}

enum SectionType {
  single
  dinamis
}

enum ValidationType {
  required
  min_length
  max_length
  numeric
  regex
}

// === USER & ROLES ===

model Users {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  avatar    String?
  name      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  roleId    Int
  role      Roles      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  pages     Page[]

  @@index([roleId])
}

model Roles {
  id        Int       @id @default(autoincrement())
  role_name RoleName  @unique
  role_desc String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users     Users[]
}

// === PAGES ===

model Page {
  id          Int                @id @default(autoincrement())
  createdById Int
  createdBy   Users              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  isPublished   Boolean          @default(false)
  isDraft       Boolean          @default(true)

  title           String
  slug            String
  desc            String?
  metaTitle       String?
  metaDescription String?
  content         Json?
  canonicalUrl    String?
  robots          String? 
  coverImageUrl   String?
  ogImageUrl      String?
}
